<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== LIDAR ==================== -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" radius="${lidar_radius}" length="${lidar_length}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${base_length/2 - lidar_radius} 0 ${base_height/2 + lidar_length/2}" rpy="0 0 3.141592653589793"/>
  </joint>

  <!-- ==================== DEPTH CAMERA ==================== -->
  <link name="depth_camera_link">
    <visual>
      <geometry>
        <box size="0.1 ${camera_size} ${camera_size}"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 ${camera_size} ${camera_size}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.05" x="0.1" y="${camera_size}" z="${camera_size}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <!-- Pitch xuống tổng 40 độ (0.698132 rad) quanh trục Y. -->
    <origin xyz="${base_length/2} 0 ${base_height/2 + 0.1}" rpy="0 0.17453 0"/>
  </joint>

  <!-- Optical Frame: Chuẩn tọa độ quang học (Z tới, X phải, Y xuống) -->
  <link name="depth_camera_optical_frame"/>

  <joint name="depth_camera_optical_joint" type="fixed">
    <parent link="depth_camera_link"/>
    <child link="depth_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- ==================== GAZEBO MATERIAL COLORS ==================== -->
  <gazebo reference="depth_camera_link">
    <material>Gazebo/Red</material>
  </gazebo>
  
  <gazebo reference="lidar_link">
    <material>Gazebo/Blue</material>
  </gazebo>

</robot>
